{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memescope-deploy",
  "main": "card-worker.js",
  "compatibility_date": "2026-04-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "BOOSTS",
      "id": "a001acd6779943f0b49a3f8e7cb9b5dc"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": false
    }
  ]
}
